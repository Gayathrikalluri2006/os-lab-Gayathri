#include<stdio.h>

int main()
{
    int n,i,time=0,highest,completed=0;
    int bt[20],rt[20],pr[20];

    printf("Enter number of processes: ");
    scanf("%d",&n);

    for(i=0;i<n;i++)
    {
        printf("Burst Time P%d: ",i+1);
        scanf("%d",&bt[i]);

        printf("Priority P%d: ",i+1);
        scanf("%d",&pr[i]);

        rt[i]=bt[i];
    }

    while(completed<n)
    {
        highest=-1;

        for(i=0;i<n;i++)
        {
            if(rt[i]>0)
            {
                if(highest==-1 || pr[i]<pr[highest])
                    highest=i;
            }
        }

        rt[highest]--;
        time++;

        if(rt[highest]==0)
            completed++;
    }

    printf("Execution Completed\n");
    return 0;
}
