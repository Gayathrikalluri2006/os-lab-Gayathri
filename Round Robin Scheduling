#include<stdio.h>

int main()
{
    int n,i,tq,remain,time=0;
    int bt[20],rt[20];

    printf("Enter Number of Processes: ");
    scanf("%d",&n);

    remain=n;

    for(i=0;i<n;i++)
    {
        printf("Burst Time P%d: ",i+1);
        scanf("%d",&bt[i]);
        rt[i]=bt[i];
    }

    printf("Enter Time Quantum: ");
    scanf("%d",&tq);

    while(remain>0)
    {
        for(i=0;i<n;i++)
        {
            if(rt[i]>0)
            {
                if(rt[i]<=tq)
                {
                    time+=rt[i];
                    rt[i]=0;
                    remain--;
                }
                else
                {
                    rt[i]-=tq;
                    time+=tq;
                }
            }
        }
    }

    printf("Total Time = %d\n",time);

    return 0;
}
