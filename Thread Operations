#include<stdio.h>
#include<pthread.h>

void *fun(void *arg)
{
    printf("Thread Running\n");
    pthread_exit(NULL);
}

int main()
{
    pthread_t t1,t2;

    pthread_create(&t1,NULL,fun,NULL);
    pthread_create(&t2,NULL,fun,NULL);

    printf("Equal=%d\n",pthread_equal(t1,t2));

    pthread_join(t1,NULL);
    pthread_join(t2,NULL);

    return 0;
}
