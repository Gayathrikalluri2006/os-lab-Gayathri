#include<stdio.h>

int main()
{
    int users,files;

    printf("Enter Number of Users: ");
    scanf("%d",&users);

    for(int i=0;i<users;i++)
    {
        printf("Enter Files for User %d: ",i+1);
        scanf("%d",&files);

        printf("User %d has %d files\n",i+1,files);
    }

    return 0;
}
